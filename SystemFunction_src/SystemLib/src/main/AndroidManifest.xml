<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />

    <!-- TzDataInstaller：8.1 / 9 / 10 RulesManager 安装、10 查询状态、8.1 UPDATE_TZDATA 广播（均为 signature|privileged） -->
    <uses-permission
        android:name="android.permission.UPDATE_TIME_ZONE_RULES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.QUERY_TIME_ZONE_RULES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.UPDATE_CONFIG"
        tools:ignore="ProtectedPermissions" />

    <application>
        <!-- TzDataInstaller：Android 8.1 广播方式下给 system_server 读取 distro.zip -->
        <provider
            android:name="com.android.systemlib.TzDistroProvider"
            android:authorities="${applicationId}.systemlib.tzdistro"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
